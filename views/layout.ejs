<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Empire Motors</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Classic CRM Sidebar Layout Styles */
    body {
      min-height: 100vh;
      overflow-x: hidden;
    }
    .wrapper {
      display: flex;
      width: 100%;
      align-items: stretch;
      min-height: 100vh;
    }
    #sidebar {
      min-width: 260px;
      max-width: 260px;
      background: #212529;
      color: #fff;
      box-shadow: 2px 0 5px rgba(0,0,0,0.1);
    }
    #sidebar .sidebar-header {
      padding: 20px;
      background: #111315;
      border-bottom: 1px solid #343a40;
    }
    #sidebar .sidebar-header h4 {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 600;
    }
    #sidebar ul.components {
      padding: 15px 0;
    }
    #sidebar ul li a {
      padding: 12px 20px;
      font-size: 1rem;
      display: block;
      color: #cfd2d6;
      text-decoration: none;
      transition: all 0.2s ease-in-out;
      border-left: 4px solid transparent;
    }
    #sidebar ul li a:hover {
      color: #fff;
      background: #343a40;
      border-left-color: #0d6efd;
    }
    #sidebar ul li.active a {
      color: #fff;
      background: #2c3034;
      border-left-color: #0d6efd;
    }
    #content {
      width: 100%;
      padding: 30px;
      background: #f8f9fa;
      min-height: 100vh;
    }
  </style>
</head>
<body>

  <div class="wrapper">
    <!-- Left Sidebar Pane -->
    <nav id="sidebar">
      <div class="sidebar-header d-flex justify-content-between align-items-center">
        <h4>🔧 Empire Motors</h4>
      </div>

      <% if (typeof user !=='undefined' && user) { %>
        <div class="p-3 bg-secondary text-white small">
          Logged in as: <strong>
            <%= user.full_name || user.username %>
          </strong>
        </div>
        <% } %>

      <ul class="list-unstyled components">
        <li>
          <a href="/">🏠 Dashboard</a>
        </li>
        <li>
          <a href="/customers">👥 Customer Data</a>
        </li>
        <li>
          <a href="/billing">💳 Billing</a>
        </li>
        <li>
          <a href="/stock">📦 Stock Management</a>
        </li>
        <li>
          <a href="/user"> Users</a>
        </li>
        <li><a href="/logout" class="text-danger">🚪 Logout</a></li>
      </ul>
    </nav>

    <!-- Main Content Area -->
    <div id="content">
      <div class="container-fluid">