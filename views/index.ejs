<%- include('layout') %>

<div class="p-5 mb-4 bg-white rounded-3 shadow-sm text-center">
  <div class="container-fluid py-5">
    <h1 class="display-5 fw-bold">Empire Motors Service & Parts CRM</h1>
    <p class="col-md-8 mx-auto fs-4 text-muted">Select a module below to get started.</p>
    
    <div class="row mt-5 justify-content-center">
      <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm border-primary">
          <div class="card-body">
            <h5 class="card-title text-primary">👥 Customer Data</h5>
            <p class="card-text small text-muted">Manage customer records, vehicle master details, and service logs.</p>
            <a href="/customers" class="btn btn-primary w-100">Open Module</a>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm border-success">
          <div class="card-body">
            <h5 class="card-title text-success">💳 Billing</h5>
            <p class="card-text small text-muted">Create and manage invoices and payment histories.</p>
            <a href="/billing" class="btn btn-success w-100">Open Module</a>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm border-primary">
          <div class="card-body">
            <h5 class="card-title text-primary">📦 Stock Management</h5>
            <p class="card-text small text-muted">Manage Spare parts inventory and details.</p>
            <a href="/spare-parts" class="btn btn-primary w-100">Open Module</a>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm border-primary">
          <div class="card-body">
            <h5 class="card-title text-primary">👥 User Management</h5>
            <p class="card-text small text-muted">Manage user accounts and permissions.</p>
            <a href="/user" class="btn btn-primary w-100">Open Module</a>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
</body>
</html>