<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Invoice #<%= invoice.id %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #fff; color: #000; padding: 30px; }
    @media print {
      .no-print { display: none; }
    }
  </style>
</head>
<body onload="window.print()">
  <div class="container" style="max-width: 700px;">
    <div class="text-center mb-4">
      <h2>🔧 AutoCare Workshop</h2>
      <p class="text-muted mb-0">Automotive Repair & Spare Parts Sales</p>
    </div>

    <div class="row mb-4">
      <div class="col-6">
        <h5>Invoice #<%= invoice.id %></h5>
        <p class="mb-1"><strong>Date:</strong> <%= new Date(invoice.created_at).toLocaleDateString() %></p>
        <p class="mb-1"><strong>Service Type:</strong> <%= invoice.service_type %></p>
      </div>
      <div class="col-6 text-end">
        <h6>Billed To:</h6>
        <p class="mb-1"><strong><%= invoice.bill_to %></strong></p>
        <p class="mb-1">Vehicle: <%= invoice.vehicle_registration_id %></p>
        <p class="mb-1"><%= invoice.bill_to_address || '' %></p>
      </div>
    </div>

    <table class="table table-bordered">
      <thead>
        <tr>
          <th>Part Code</th>
          <th>Product Name</th>
          <th class="text-end">MRP Price</th>
        </tr>
      </thead>
      <tbody>
        <% if (parts.length === 0) { %>
          <tr><td colspan="3" class="text-center text-muted">No spare parts attached to this invoice.</td></tr>
        <% } %>
        <% parts.forEach(p => { %>
          <tr>
            <td><%= p.product_code %></td>
            <td><%= p.product_name %></td>
            <td class="text-end">$<%= Number(p.mrp_price).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2" class="text-end fw-bold">Total Bill Amount:</td>
          <td class="text-end fw-bold">$<%= Number(invoice.total_bill).toFixed(2) %></td>
        </tr>
      </tfoot>
    </table>

    <div class="text-center mt-5 no-print">
      <button onclick="window.print()" class="btn btn-primary">Print Again</button>
      <button onclick="window.close()" class="btn btn-secondary">Close Window</button>
    </div>
  </div>
</body>
</html>