<%- include('layout') %>

<a href="/" class="btn btn-secondary btn-sm mb-3">&larr; Back to Dashboard</a>

<div class="row">
  <!-- Add New Spare Part Form -->
  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">📦 Add New Spare Part</h5>
      </div>
      <div class="card-body">
        <form action="/stock/new" method="POST">
          <div class="mb-2">
            <label class="form-label">Product Code</label>
            <input type="text" name="product_code" class="form-control" placeholder="e.g. SP-1029" required>
          </div>
          <div class="mb-2">
            <label class="form-label">Product Name</label>
            <input type="text" name="product_name" class="form-control" placeholder="e.g. Brake Pad Kit" required>
          </div>
          <div class="row">
            <div class="col-md-6 mb-2">
              <label class="form-label">Stock Quantity</label>
              <input type="number" name="closing_stock" class="form-control" value="0" min="0" required>
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label">Source</label>
              <input type="text" name="source" class="form-control" placeholder="e.g. Vendor A">
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">MRP Price ($)</label>
              <input type="number" step="0.01" name="mrp_price" class="form-control" placeholder="0.00" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Purchase Price ($)</label>
              <input type="number" step="0.01" name="purchase_price" class="form-control" placeholder="0.00" required>
            </div>
          </div>
          <button type="submit" class="btn btn-success w-100">Add to Stock</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Stock Search & Inventory List -->
  <div class="col-md-8">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Stock Inventory</h5>
        <form action="/stock" method="GET" class="d-flex w-50">
          <input type="text" name="search" class="form-control form-control-sm me-2" placeholder="Search Code/Name/Source..." value="<%= search %>">
          <button type="submit" class="btn btn-light btn-sm">Search</button>
        </form>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Code</th>
              <th>Product Name</th>
              <th>Closing Stock</th>
              <th>Source</th>
              <th>MRP</th>
              <th>Purchase</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if(items.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">
                  <%= search ? 'No inventory records found matching your search.' : 'Use the search bar above to look up spare parts.' %>
                </td>
              </tr>
            <% } %>
            <% items.forEach(item => { %>
              <tr>
                <td><span class="badge bg-secondary"><%= item.product_code %></span></td>
                <td><strong><%= item.product_name %></strong></td>
                <td>
                  <span class="badge <%= item.closing_stock > 5 ? 'bg-success' : 'bg-danger' %>">
                    <%= item.closing_stock %>
                  </span>
                </td>
                <td><%= item.source || '-' %></td>
                <td>$<%= Number(item.mrp_price).toFixed(2) %></td>
                <td>$<%= Number(item.purchase_price).toFixed(2) %></td>
                <td>
                  <a href="/stock/<%= item.id %>/edit" class="btn btn-sm btn-outline-warning">Edit</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</div>
</div>
</body>
</html>